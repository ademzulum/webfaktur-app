# Vorlage. Echte Werte gehören in .env.local (wird von Git ignoriert).

# --- Supabase ---------------------------------------------------------------
# Dashboard -> Settings -> API Keys
# Beide Werte sind für den Browser bestimmt und daher nicht geheim.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Twilio -----------------------------------------------------------------
# GEHEIM. Niemals mit NEXT_PUBLIC_ versehen und niemals ins Repository.
#
# TWILIO_ACCOUNT_SID     Console-Startseite, beginnt mit AC...
# TWILIO_API_KEY_SID     Account -> API keys & tokens -> Create API key,
#                        beginnt mit SK... (bewusst NICHT der Auth Token)
# TWILIO_API_KEY_SECRET  wird beim Anlegen des API Keys EINMALIG angezeigt
# TWILIO_ABSENDER        gekaufte Twilio-Nummer im Format +43...
#                        oder ein alphanumerischer Absendername
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_ABSENDER=

# --- Adresse der Anwendung --------------------------------------------------
# Grundlage für die Links in der SMS.
# Lokal: http://localhost:3000   Auf Vercel: https://deine-domain
APP_BASIS_URL=http://localhost:3000
