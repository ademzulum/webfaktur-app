# Vorlage. Echte Werte gehören in .env.local (wird von Git ignoriert).

# --- Supabase ---------------------------------------------------------------
# Dashboard -> Settings -> API Keys
# Beide Werte sind für den Browser bestimmt und daher nicht geheim.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Bird (SMS-Versand) -----------------------------------------------------
# GEHEIM. Niemals mit NEXT_PUBLIC_ versehen und niemals ins Repository.
#
# BIRD_API_KEY    Zugangsschlüssel aus dem Bird-Arbeitsbereich.
#                 Beginnt mit bk_eu1_ (Europa) oder bk_us1_ (USA).
#                 Die Region liest der Code selbst aus dem Vorsatz.
# BIRD_ABSENDER   Eigene Nummer im Format +43...
#                 ODER ein Absendername aus 3 bis 11 Zeichen, z. B. Webfaktur
BIRD_API_KEY=
BIRD_ABSENDER=

# --- Adresse der Anwendung --------------------------------------------------
# Grundlage für die Links in der SMS.
# Lokal: http://localhost:3000   Auf Vercel: https://deine-domain
APP_BASIS_URL=http://localhost:3000
